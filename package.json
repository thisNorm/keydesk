{
  "name": "keydesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "개인용 API 키 보관함과 호출 게이트웨이",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node tools/manage.mjs setup",
    "dev": "node tools/manage.mjs dev",
    "start": "node tools/manage.mjs start",
    "stop": "node tools/manage.mjs stop",
    "status": "node tools/manage.mjs status",
    "backup": "node tools/manage.mjs backup",
    "restore": "node tools/manage.mjs restore",
    "reset-password": "node tools/manage.mjs reset-password",
    "build": "npm run build --workspace @keydesk/web && npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node tools/test.mjs",
    "format:check": "prettier --check --ignore-unknown --ignore-path .gitignore apps packages tools docs README.md AGENTS.md CLAUDE.md DESIGN.md package.json compose.yaml .github/workflows/keydesk.yml",
    "backup:scheduled": "node tools/scheduled-backup.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "ipaddr.js": "2.2.0",
    "nodemailer": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
